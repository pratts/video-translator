# Secrets. Copy to .env. Other settings live in config.toml (see config.example.toml);
# any of them can also be set here in upper case (e.g. TRANSLATOR="gpt") and then override config.toml.

# OpenAI API key, for TRANSLATOR=gpt
OPENAI_API_KEY="openai_api_key_here"
# Path to the Google Cloud service account JSON key, for TRANSLATOR=google
GOOGLE_APPLICATION_CREDENTIALS="api-key-path.json"
# Hugging Face token with access to https://huggingface.co/pyannote/speaker-diarization-community-1 (diarization)
HF_TOKEN="hugging_face_token"
