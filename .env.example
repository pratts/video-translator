# Demucs source separation: model (htdemucs_ft = best quality, htdemucs = ~4x faster) and device (cuda/mps/cpu, empty = auto)
DEMUCS_MODEL="htdemucs_ft"
DEMUCS_DEVICE=""
# Speech recognition: backend (whisperx, or mlx on Apple Silicon), Whisper model, source language (empty = auto-detect) and device (cuda/cpu, empty = auto)
ASR_BACKEND="whisperx"
WHISPER_MODEL="large-v3-turbo"
SOURCE_LANGUAGE=""
ASR_DEVICE=""
# Speaker diarization (needs a Hugging Face token with access to https://huggingface.co/pyannote/speaker-diarization-community-1)
HF_TOKEN="hugging_face_token"
# Exact or min/max number of speakers if known (empty = auto) and device (cuda/mps/cpu, empty = auto)
NUM_SPEAKERS=""
MIN_SPEAKERS=""
MAX_SPEAKERS=""
DIARIZATION_DEVICE=""
# Translation backend: google (Google Cloud Translation), gpt (OpenAI or any OpenAI-compatible LLM server) or nllb (fully local NLLB-200)
TRANSLATOR="google"
# Target language code (e.g. en, es, hi). The source language is taken from the transcript
TARGET_LANGUAGE="en"
# Optional JSON glossary file {"source term": "translation"} and a short description of the video (used by gpt)
GLOSSARY_FILE=""
VIDEO_CONTEXT=""
# Google: path to the service account JSON key
GOOGLE_APPLICATION_CREDENTIALS="api-key-path.json"
# gpt: API key, model, and base URL for OpenAI-compatible servers (e.g. Ollama: http://localhost:11434/v1, empty = OpenAI)
OPENAI_API_KEY="openai_api_key_here"
LLM_MODEL="gpt-5-mini"
LLM_BASE_URL=""
# nllb: Hugging Face model and device (cuda/mps/cpu, empty = auto)
NLLB_MODEL="facebook/nllb-200-distilled-600M"
TRANSLATION_DEVICE=""
# Voice cloning: TTS backend (f5) and device (cuda/mps/cpu, empty = auto)
TTS_BACKEND="f5"
F5_MODEL="F5TTS_v1_Base"
TTS_DEVICE=""
# Check every clip with speech recognition and retry up to TTS_ATTEMPTS times if it does not say the intended text
TTS_VERIFY="true"
TTS_ATTEMPTS="3"
# Fitting clips into their time slots: allowed playback speed (below 1 = slower), hard limit before warning,
# seconds of following silence a clip may use, and how many times an LLM translator may shorten a line
FIT_MIN_SPEED="0.9"
FIT_MAX_SPEED="1.25"
FIT_HARD_MAX_SPEED="1.6"
FIT_MAX_BORROW="0.5"
FIT_MAX_RETRANSLATIONS="2"
# Mixing: loudness target (-16 LUFS for web, -23 for broadcast), true-peak limit (dBTP), how much the background
# is lowered under dubbed speech (dB), and the level of original vocal sounds outside dubbed lines (dB, empty = off)
MIX_TARGET_LUFS="-16"
MIX_TRUE_PEAK="-1.5"
MIX_DUCK_DB="-6"
MIX_KEEP_VOCALS_DB=""
