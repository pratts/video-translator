OPENAI_API_KEY="openai_api_key_here"
GOOGLE_APPLICATION_CREDENTIALS="api-key-path.json"
TRANSLATOR="google"
# Demucs source separation: model (htdemucs_ft = best quality, htdemucs = ~4x faster) and device (cuda/mps/cpu, empty = auto)
DEMUCS_MODEL="htdemucs_ft"
DEMUCS_DEVICE=""
HF_TOKEN="hugging_face_token"
# Speech recognition: backend (whisperx, or mlx on Apple Silicon), Whisper model, source language (empty = auto-detect) and device (cuda/cpu, empty = auto)
ASR_BACKEND="whisperx"
WHISPER_MODEL="large-v3-turbo"
SOURCE_LANGUAGE=""
ASR_DEVICE=""
